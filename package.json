{
  "name": "tonexpedal",
  "version": "1.2.0",
  "description": "Single-page web controller and ESP32 wireless bridge for the IK Multimedia TONEX Pedal",
  "scripts": {
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "simulator": "node tools/bridge_simulator.js",
    "hardware:probe": "python3 tools/tonex_hardware_probe.py",
    "hardware:inventory": "python3 tools/tonex_usb_inventory.py",
    "hardware:midi-monitor": "swift tools/tonex_midi_monitor.swift",
    "hardware:midi-probe": "swift tools/tonex_midi_probe.swift",
    "hardware:midi-cc-probe": "swift tools/tonex_midi_cc_probe.swift",
    "hardware:midi-stress": "python3 tools/tonex_midi_stress.py",
    "hardware:control-capture": "python3 tools/tonex_control_capture.py",
    "hardware:state-watch": "python3 tools/tonex_state_watch.py",
    "diagnostics:summary": "node tools/summarize_diagnostic.js"
  },
  "keywords": [
    "tonex",
    "midi",
    "webmidi",
    "webserial",
    "esp32",
    "esp32-s3",
    "guitar-pedal"
  ],
  "author": "brunothesatellite",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "ws": "^8.21.0"
  }
}
